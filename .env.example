APP_NAME=Gross Profit

# MySQL connection string used by mysql2.
# Local dev (no Docker): localhost
# DATABASE_URL="mysql://user:password@localhost:3306/gross_profit"
# Docker Compose local: host must be the db service name, not localhost
# DATABASE_URL="mysql://app:app@db:3306/app"
# AWS RDS (us-east-2). Replace USER and PASSWORD with the RDS credentials.
# DATABASE_URL="mysql://USER:PASSWORD@grcp.c9q0kssi8kzk.us-east-2.rds.amazonaws.com:3306/grpc"

# Secret used to sign & verify JWTs. Use a long, random string.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# TMS / external API that supplies trips, mileage, income, driver pay, fee rates.
# When unset, sheet generation via GET /api/sheets is disabled (POST still works
# with an explicit payload). See lib/sources/tms.ts.
TMS_API_URL=""
TMS_API_TOKEN=""

# Relay TMS Fuel API — OO retail vs paid (pnpm sync:relay-fuel / generate:report).
# Authorization header = raw API key (not Bearer). Node-only.
RELAY_API_URL="https://app.relaypayments.com/api"
RELAY_API_KEY=""

# SFTP server that delivers the fuel-card .dat extracts. Used by the scheduled
# sync (pnpm sync:fuel / sync:fuel:daemon).
SFTP_HOST="files.relaypayments.com"
SFTP_PORT="22"
SFTP_USERNAME=""
SFTP_PASSWORD=""
# Optional: use a private key instead of a password (path to the key file).
SFTP_PRIVATE_KEY_PATH=""
# Remote directory containing the .dat files.
SFTP_REMOTE_DIR="/out"
# Optional: where downloaded files are staged locally (default data/sftp-incoming).
SFTP_STAGING_DIR=""
# Optional: daemon interval override in ms (default 1800000 = 30 min).
SFTP_SYNC_INTERVAL_MS="1800000"

# Prepass toll API — OAuth2 client credentials. Daily sync (pnpm sync:tolls).
# Node-only. Populates toll_transactions (PREPASS source).
PREPASS_TOKEN_URL="https://api.prepass.com/auth/v1/token"
PREPASS_API_URL="https://api.prepass.com/tolltransaction/v1/transactions"
PREPASS_CLIENT_ID=""
PREPASS_CLIENT_SECRET=""
# Optional OAuth scope, if the API requires one.
PREPASS_SCOPE=""
# Account number(s) to query (comma-separated for multiple).
PREPASS_ACCOUNT_NUMBERS="364034"
# Rolling window (days back from today) the daily sync fetches.
PREPASS_LOOKBACK_DAYS="14"

# OpenRoad TMS drivers API — HTTP Basic auth. Daily sync (pnpm sync:tms-drivers)
# paginates the full list into tms_drivers. Node-only.
OPENROAD_DRIVERS_URL="https://app.openroadtms.com/api/ext/v1/drivers"
OPENROAD_USERS_URL="https://app.openroadtms.com/api/ext/v1/users"
OPENROAD_TRUCKS_URL="https://app.openroadtms.com/api/ext/v1/trucks"
OPENROAD_ASSIGNMENTS_URL="https://app.openroadtms.com/api/ext/v1/assignments"
OPENROAD_COMPENSATIONS_URL="https://app.openroadtms.com/api/ext/v1/compensations"
OPENROAD_LOADS_URL="https://app.openroadtms.com/api/ext/v1/loads"
OPENROAD_LOAD_FINANCIALS_URL="https://app.openroadtms.com/api/ext/v1/load_financials"
OPENROAD_DRIVER_ROUTES_URL="https://app.openroadtms.com/api/ext/v1/driver_routes"
# OpenRoad UTC timestamps are stored as this fleet timezone for DATE() week buckets.
APP_TIMEZONE="America/Chicago"
OPENROAD_API_USERNAME=""
OPENROAD_API_PASSWORD=""
OPENROAD_PER_PAGE="100"

# Samsara API — Bearer token with the "Read Fuel & Energy" scope. Used by the
# weekly MPG sync (pnpm sync:samsara-mpg). Node-only.
SAMSARA_API_TOKEN=""
SAMSARA_API_URL="https://api.samsara.com"

# Optional overrides for the seeded admin user (pnpm db:seed).
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="password123"

# Retention module (merged into this app).
# live (default) = MySQL drivers + gross_profit_reports. mock = opt-in demo roster only.
GP_ADAPTER=live
NEXT_PUBLIC_GP_ADAPTER=live
# Retention SMS
# IMPORTANT: XXII Century ≠ AZFS. Use XXII Century GHL location only (not FMS/AZFS).
# RETENTION_SMS_PROVIDER=ghl
#
# GoHighLevel — XXII Century Inc (Retention surveys / occasions)
# GHL_LOCATION_ID=
# GHL_PRIVATE_INTEGRATION_KEY=
# GHL_API_VERSION=2021-07-28
#
# Twilio — optional fallback only (do not rely on AZFS Twilio for Retention)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=
# TWILIO_FROM_NUMBER=


# Retention cron (AWS / supercronic) — see crontab + scripts/cron/*.sh
# Pipelines (locked, ordered, soft-fail per step):
#   daily-tms        03:00 ET  OpenRoad/TMS syncs
#   weekly-gp        Tue 05:00 ET  Samsara + generate:report
#   daily-retention  08:00 ET  occasions + surveys + reminders
#   fuel             */30      SFTP fuel import
# Manual: bash scripts/cron/daily-tms.sh
# TEMP test driver (Shahmeer) — remove before/after prod soak: pnpm retention:remove-test-driver
# RETENTION_TEST_DRIVER_ID=900000001
# RETENTION_TEST_DRIVER_PHONE=+13606679564
# RETENTION_TEST_DRIVER_FIRST=Shahmeer
# RETENTION_TEST_DRIVER_LAST=RetentionTest

# Optional: extra birthday CC list (comma-separated). Dispatch uses DISPATCH_EMAILS.
# DISPATCH_MANAGER_EMAILS=
# LEADERSHIP_EMAILS=
NEXT_PUBLIC_SURVEY_BASE_URL="https://v2.goxxii.com/s"
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""
JAMES_EMAIL="James@goxxii.com"
MAINTENANCE_EMAIL="Ozzy@goxxii.com"
ACCOUNTING_EMAIL="accounting@goxxii.com"
DISPATCH_EMAILS="Art@goxxii.com,Eric@goxxii.com"
SAFETY_EMAIL="Safety@goxxii.com"

# Retention email (XXII Century) — Nadia: notifications@goxxii.com / XXII Century Notifications
# James always receives at-risk + birthday leadership notices (JAMES_EMAIL).
# Gmail Workspace: smtp.gmail.com:587 STARTTLS + Google App Password (spaces stripped).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@goxxii.com
SMTP_PASS=
SMTP_FROM=notifications@goxxii.com
SMTP_FROM_NAME=XXII Century Notifications
SMTP_REPLY_TO=James@goxxii.com
# Optional hosted logo for email header (PNG/JPG). Without it, emails use the XXII badge mark.
# EMAIL_BRAND_LOGO_URL="https://your-cdn/xxii-logo.png"
# NEXT_PUBLIC_APP_URL="https://your-host"   # used in case links inside emails

# Email testing — true = send all retention mail to RETENTION_EMAIL_TEST_TO only
# (James / dept addresses are listed in the body). false = production routing.
RETENTION_EMAIL_TESTING=true
RETENTION_EMAIL_TEST_TO=shahmeer@azfsllc.com

# Google Chat (Workspace) — celebrate 4–5 star surveys in a Space (Incoming Webhook).
# Same pattern as FMS onboarding Chat notifies. Create webhook in the Space → Apps → Incoming webhook.
# GOOGLE_CHAT_RETENTION_CELEBRATE_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=..."
# GOOGLE_CHAT_WEBHOOK_TIMEOUT_MS=10000


# Optional. Redis cache in front of MySQL for Retention hot reads.
# REDIS_URL="redis://localhost:6379"

